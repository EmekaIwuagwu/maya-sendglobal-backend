generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AppRole {
  user
  admin
  support
  compliance
  super_admin
}

enum KycStatus {
  not_started
  pending
  submitted
  under_review
  approved
  rejected
  expired
}

enum KycTier {
  tier0
  tier1
  tier2
  tier3
}

enum AccountStatus {
  active
  suspended
  frozen
  under_review
  closed
}

enum TransactionType {
  send
  receive
  withdraw
  deposit
  escrow
  request
  card_payment
  card_load
  refund
  fee
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
  cancelled
  refunded
}

enum EscrowStatus {
  locked
  released
  disputed
  cancelled
  resolved
}

enum DisputeType {
  unauthorized
  not_received
  wrong_amount
  fraud
  quality
  other
}

enum DisputeStatus {
  open
  under_review
  escalated
  resolved
  closed
}

enum CardType {
  virtual
  physical
}

enum CardStatus {
  pending
  active
  frozen
  cancelled
  expired
}

enum WithdrawalMethod {
  bank_transfer
  mobile_money
  crypto_wallet
  card
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
  flagged
  cancelled
}

enum SupportTicketStatus {
  open
  in_progress
  waiting_user
  waiting_internal
  resolved
  closed
}

enum SupportTicketPriority {
  low
  medium
  high
  urgent
}

enum NotificationType {
  transaction
  kyc
  security
  card
  escrow
  dispute
  support
  system
  marketing
}

enum NotificationChannel {
  in_app
  email
  sms
  push
}

// ============================================================================
// CORE USER TABLES
// ============================================================================

model User {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  web3authId           String         @unique @map("web3auth_id")
  walletAddress        String         @unique @map("wallet_address") @db.VarChar(42)
  email                String?        @unique @db.VarChar(255)
  emailVerified        Boolean        @default(false) @map("email_verified")
  phone                String?        @db.VarChar(50)
  phoneVerified        Boolean        @default(false) @map("phone_verified")
  fullName             String?        @map("full_name") @db.VarChar(255)
  dateOfBirth          DateTime?      @map("date_of_birth") @db.Date
  country              String?        @db.VarChar(2)
  city                 String?        @db.VarChar(100)
  address              String?
  postalCode           String?        @map("postal_code") @db.VarChar(20)
  kycStatus            KycStatus      @default(not_started) @map("kyc_status")
  kycTier              KycTier        @default(tier0) @map("kyc_tier")
  accountStatus        AccountStatus  @default(active) @map("account_status")
  balanceUsdc          Decimal        @default(0) @map("balance_usdc") @db.Decimal(20, 6)
  balanceLocked        Decimal        @default(0) @map("balance_locked") @db.Decimal(20, 6)
  profilePictureUrl    String?        @map("profile_picture_url")
  preferredLanguage    String         @default("en") @map("preferred_language") @db.VarChar(10)
  preferredCurrency    String         @default("USD") @map("preferred_currency") @db.VarChar(3)
  timezone             String?        @db.VarChar(50)
  twoFactorEnabled     Boolean        @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?        @map("two_factor_secret") @db.VarChar(255)
  lastLoginAt          DateTime?      @map("last_login_at")
  lastLoginIp          String?        @map("last_login_ip")
  riskScore            Int            @default(0) @map("risk_score")
  isVerified           Boolean        @default(false) @map("is_verified")
  referralCode         String?        @unique @map("referral_code") @db.VarChar(20)
  referredById         String?        @map("referred_by") @db.Uuid
  metadata             Json           @default("{}")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  // Relations
  referredBy           User?          @relation("UserReferrals", fields: [referredById], references: [id])
  referrals            User[]         @relation("UserReferrals")
  roles                UserRole[]
  wallets              Wallet[]
  sentTransactions     Transaction[]  @relation("SentTransactions")
  receivedTransactions Transaction[]  @relation("ReceivedTransactions")
  recipients           Recipient[]
  moneyRequestsSent    MoneyRequest[] @relation("MoneyRequestsSent")
  moneyRequestsReceived MoneyRequest[] @relation("MoneyRequestsReceived")
  escrowsSent          Escrow[]       @relation("EscrowsSent")
  escrowsReceived      Escrow[]       @relation("EscrowsReceived")
  kycSubmissions       KycSubmission[]
  cards                Card[]
  cardTransactions     CardTransaction[]
  withdrawals          Withdrawal[]
  disputesFiled        Dispute[]      @relation("DisputesFiled")
  supportTickets       SupportTicket[]
  notifications        Notification[]
  preferences          UserPreference?
  auditLogs            AuditLog[]     @relation("UserAuditLogs")
  adminAuditLogs       AuditLog[]     @relation("AdminAuditLogs")
  emailPaymentsSent    EmailPayment[] @relation("EmailPaymentsSent")
  emailPaymentsClaimed EmailPayment[] @relation("EmailPaymentsClaimed")
  referralsGiven       Referral[]     @relation("ReferralsGiven")
  referralsReceived    Referral[]     @relation("ReferralsReceived")
  fraudAlerts          FraudAlert[]

  @@index([walletAddress])
  @@index([email])
  @@index([kycStatus])
  @@index([accountStatus])
  @@map("users")
}

model UserRole {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       AppRole
  grantedBy  String?  @map("granted_by") @db.Uuid
  grantedAt  DateTime @default(now()) @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

// ============================================================================
// WALLETS
// ============================================================================

model Wallet {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  walletAddress  String    @unique @map("wallet_address") @db.VarChar(42)
  walletType     String    @default("embedded") @map("wallet_type") @db.VarChar(20)
  chain          String    @db.VarChar(20)
  network        String    @default("mainnet") @db.VarChar(20)
  isPrimary      Boolean   @default(false) @map("is_primary")
  balanceUsdc    Decimal   @default(0) @map("balance_usdc") @db.Decimal(20, 6)
  nonce          Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")

  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletAddress])
  @@map("wallets")
}

// ============================================================================
// TRANSACTIONS
// ============================================================================

model Transaction {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionHash         String?           @unique @map("transaction_hash") @db.VarChar(66)
  senderId                String?           @map("sender_id") @db.Uuid
  senderWallet            String?           @map("sender_wallet") @db.VarChar(42)
  recipientId             String?           @map("recipient_id") @db.Uuid
  recipientWallet         String?           @map("recipient_wallet") @db.VarChar(42)
  recipientEmail          String?           @map("recipient_email") @db.VarChar(255)
  amountUsdc              Decimal           @map("amount_usdc") @db.Decimal(20, 6)
  feeUsdc                 Decimal           @default(0) @map("fee_usdc") @db.Decimal(20, 6)
  transactionType         TransactionType   @map("transaction_type")
  status                  TransactionStatus @default(pending)
  chain                   String            @db.VarChar(20)
  network                 String            @default("mainnet") @db.VarChar(20)
  blockNumber             BigInt?           @map("block_number")
  gasUsed                 BigInt?           @map("gas_used")
  gasPrice                Decimal?          @map("gas_price") @db.Decimal(20, 6)
  gasSponsored            Boolean           @default(true) @map("gas_sponsored")
  paymasterTxHash         String?           @map("paymaster_tx_hash") @db.VarChar(66)
  paymasterSponsorAddress String?           @map("paymaster_sponsor_address") @db.VarChar(42)
  note                    String?
  referenceNumber         String?           @unique @map("reference_number") @db.VarChar(50)
  metadata                Json              @default("{}")
  flagged                 Boolean           @default(false)
  flaggedReason           String?           @map("flagged_reason")
  flaggedAt               DateTime?         @map("flagged_at")
  flaggedBy               String?           @map("flagged_by") @db.Uuid
  ipAddress               String?           @map("ip_address")
  userAgent               String?           @map("user_agent")
  createdAt               DateTime          @default(now()) @map("created_at")
  processingAt            DateTime?         @map("processing_at")
  completedAt             DateTime?         @map("completed_at")
  failedAt                DateTime?         @map("failed_at")
  failureReason           String?           @map("failure_reason")

  sender                  User?             @relation("SentTransactions", fields: [senderId], references: [id])
  recipient               User?             @relation("ReceivedTransactions", fields: [recipientId], references: [id])
  escrow                  Escrow?
  disputes                Dispute[]
  moneyRequest            MoneyRequest?
  cardTransaction         CardTransaction?
  emailPayment            EmailPayment?
  withdrawal              Withdrawal?

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([transactionType])
  @@index([createdAt(sort: Desc)])
  @@index([transactionHash])
  @@map("transactions")
}

// ============================================================================
// RECIPIENTS/BENEFICIARIES
// ============================================================================

model Recipient {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  recipientName      String    @map("recipient_name") @db.VarChar(255)
  walletAddress      String?   @map("wallet_address") @db.VarChar(42)
  email              String?   @db.VarChar(255)
  phone              String?   @db.VarChar(50)
  bankAccountNumber  String?   @map("bank_account_number") @db.VarChar(100)
  bankName           String?   @map("bank_name") @db.VarChar(255)
  bankRoutingNumber  String?   @map("bank_routing_number") @db.VarChar(50)
  mobileMoneyNumber  String?   @map("mobile_money_number") @db.VarChar(50)
  mobileMoneyProvider String?  @map("mobile_money_provider") @db.VarChar(100)
  nickname           String?   @db.VarChar(100)
  country            String?   @db.VarChar(2)
  isFavorite         Boolean   @default(false) @map("is_favorite")
  isVerified         Boolean   @default(false) @map("is_verified")
  totalSent          Decimal   @default(0) @map("total_sent") @db.Decimal(20, 6)
  transactionCount   Int       @default(0) @map("transaction_count")
  lastSentAt         DateTime? @map("last_sent_at")
  tags               String[]
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletAddress])
  @@map("recipients")
}

// ============================================================================
// MONEY REQUESTS
// ============================================================================

model MoneyRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId     String?   @map("requester_id") @db.Uuid
  payerId         String?   @map("payer_id") @db.Uuid
  payerEmail      String?   @map("payer_email") @db.VarChar(255)
  payerWallet     String?   @map("payer_wallet") @db.VarChar(42)
  amountUsdc      Decimal   @map("amount_usdc") @db.Decimal(20, 6)
  description     String?
  status          String    @default("pending") @db.VarChar(20)
  requestLink     String?   @unique @map("request_link") @db.VarChar(255)
  requestCode     String?   @unique @map("request_code") @db.VarChar(20)
  transactionId   String?   @unique @map("transaction_id") @db.Uuid
  reminderCount   Int       @default(0) @map("reminder_count")
  lastReminderAt  DateTime? @map("last_reminder_at")
  expiresAt       DateTime? @map("expires_at")
  paidAt          DateTime? @map("paid_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  requester       User?     @relation("MoneyRequestsSent", fields: [requesterId], references: [id])
  payer           User?     @relation("MoneyRequestsReceived", fields: [payerId], references: [id])
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  @@index([requesterId])
  @@index([payerId])
  @@index([status])
  @@map("money_requests")
}

// ============================================================================
// ESCROW
// ============================================================================

model Escrow {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId         String?       @unique @map("transaction_id") @db.Uuid
  senderId              String?       @map("sender_id") @db.Uuid
  recipientId           String?       @map("recipient_id") @db.Uuid
  amountUsdc            Decimal       @map("amount_usdc") @db.Decimal(20, 6)
  escrowAddress         String?       @map("escrow_address") @db.VarChar(42)
  smartContractAddress  String?       @map("smart_contract_address") @db.VarChar(42)
  releaseCondition      String?       @map("release_condition")
  autoReleaseDate       DateTime?     @map("auto_release_date")
  status                EscrowStatus  @default(locked)
  disputeReason         String?       @map("dispute_reason")
  disputeId             String?       @map("dispute_id") @db.Uuid
  resolvedBy            String?       @map("resolved_by") @db.Uuid
  resolutionNotes       String?       @map("resolution_notes")
  metadata              Json          @default("{}")
  createdAt             DateTime      @default(now()) @map("created_at")
  lockedAt              DateTime?     @map("locked_at")
  releasedAt            DateTime?     @map("released_at")
  disputedAt            DateTime?     @map("disputed_at")
  resolvedAt            DateTime?     @map("resolved_at")

  transaction           Transaction?  @relation(fields: [transactionId], references: [id])
  sender                User?         @relation("EscrowsSent", fields: [senderId], references: [id])
  recipient             User?         @relation("EscrowsReceived", fields: [recipientId], references: [id])
  disputes              Dispute[]

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@map("escrows")
}

// ============================================================================
// KYC SUBMISSIONS
// ============================================================================

model KycSubmission {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String     @map("user_id") @db.Uuid
  tier                KycTier
  documentType        String     @map("document_type") @db.VarChar(50)
  documentNumber      String?    @map("document_number") @db.VarChar(100)
  documentCountry     String?    @map("document_country") @db.VarChar(2)
  documentFrontUrl    String?    @map("document_front_url")
  documentBackUrl     String?    @map("document_back_url")
  selfieUrl           String?    @map("selfie_url")
  addressProofUrl     String?    @map("address_proof_url")
  additionalDocuments Json       @default("[]") @map("additional_documents")
  status              KycStatus  @default(pending)
  rejectionReason     String?    @map("rejection_reason")
  rejectionCategory   String?    @map("rejection_category") @db.VarChar(50)
  reviewedBy          String?    @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?  @map("reviewed_at")
  reviewNotes         String?    @map("review_notes")
  priority            String     @default("medium") @db.VarChar(20)
  verificationScore   Int?       @map("verification_score")
  fraudCheckPassed    Boolean?   @map("fraud_check_passed")
  documentVerified    Boolean?   @map("document_verified")
  faceMatchScore      Decimal?   @map("face_match_score") @db.Decimal(5, 2)
  submittedAt         DateTime   @default(now()) @map("submitted_at")
  expiresAt           DateTime?  @map("expires_at")
  metadata            Json       @default("{}")

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([tier])
  @@map("kyc_submissions")
}

// ============================================================================
// CARDS (Virtual & Physical)
// ============================================================================

model Card {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String         @map("user_id") @db.Uuid
  cardType              CardType       @map("card_type")
  cardStatus            CardStatus     @default(pending) @map("card_status")
  cardNumberEncrypted   String?        @map("card_number_encrypted")
  cardNumberLast4       String?        @map("card_number_last4") @db.VarChar(4)
  cardholderName        String?        @map("cardholder_name") @db.VarChar(255)
  expiryMonth           Int?           @map("expiry_month")
  expiryYear            Int?           @map("expiry_year")
  cvvEncrypted          String?        @map("cvv_encrypted")
  cardNetwork           String?        @map("card_network") @db.VarChar(20)
  issuer                String?        @db.VarChar(100)
  issuingCountry        String?        @map("issuing_country") @db.VarChar(2)
  balanceUsdc           Decimal        @default(0) @map("balance_usdc") @db.Decimal(20, 6)
  spendingLimitDaily    Decimal?       @map("spending_limit_daily") @db.Decimal(20, 6)
  spendingLimitMonthly  Decimal?       @map("spending_limit_monthly") @db.Decimal(20, 6)
  spendingToday         Decimal        @default(0) @map("spending_today") @db.Decimal(20, 6)
  spendingThisMonth     Decimal        @default(0) @map("spending_this_month") @db.Decimal(20, 6)
  billingAddress        String?        @map("billing_address")
  shippingAddress       String?        @map("shipping_address")
  shippingTracking      String?        @map("shipping_tracking") @db.VarChar(100)
  pinSet                Boolean        @default(false) @map("pin_set")
  pinEncrypted          String?        @map("pin_encrypted")
  isPrimary             Boolean        @default(false) @map("is_primary")
  freezeReason          String?        @map("freeze_reason")
  cancelledReason       String?        @map("cancelled_reason")
  cardProvider          String?        @map("card_provider") @db.VarChar(50)
  providerCardId        String?        @map("provider_card_id") @db.VarChar(255)
  activationDate        DateTime?      @map("activation_date")
  lastUsedAt            DateTime?      @map("last_used_at")
  metadata              Json           @default("{}")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardTransactions      CardTransaction[]
  disputes              Dispute[]
  supportTickets        SupportTicket[]

  @@index([userId])
  @@index([cardStatus])
  @@index([cardNumberLast4])
  @@map("cards")
}

// ============================================================================
// CARD TRANSACTIONS
// ============================================================================

model CardTransaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId           String?           @map("card_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  transactionId    String?           @unique @map("transaction_id") @db.Uuid
  merchantName     String?           @map("merchant_name") @db.VarChar(255)
  merchantCategory String?           @map("merchant_category") @db.VarChar(100)
  merchantCountry  String?           @map("merchant_country") @db.VarChar(2)
  amountUsdc       Decimal           @map("amount_usdc") @db.Decimal(20, 6)
  originalAmount   Decimal?          @map("original_amount") @db.Decimal(20, 6)
  originalCurrency String?           @map("original_currency") @db.VarChar(3)
  exchangeRate     Decimal?          @map("exchange_rate") @db.Decimal(10, 6)
  transactionType  String?           @map("transaction_type") @db.VarChar(50)
  status           TransactionStatus @default(pending)
  authorizationCode String?          @map("authorization_code") @db.VarChar(50)
  declinedReason   String?           @map("declined_reason")
  isInternational  Boolean           @default(false) @map("is_international")
  isOnline         Boolean           @default(false) @map("is_online")
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now()) @map("created_at")
  settledAt        DateTime?         @map("settled_at")

  card             Card?             @relation(fields: [cardId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  transaction      Transaction?      @relation(fields: [transactionId], references: [id])
  disputes         Dispute[]

  @@index([cardId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("card_transactions")
}

// ============================================================================
// WITHDRAWALS
// ============================================================================

model Withdrawal {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?          @map("user_id") @db.Uuid
  amountUsdc         Decimal          @map("amount_usdc") @db.Decimal(20, 6)
  withdrawalMethod   WithdrawalMethod @map("withdrawal_method")
  destinationDetails Json             @map("destination_details")
  destinationMasked  String?          @map("destination_masked") @db.VarChar(255)
  status             WithdrawalStatus @default(pending)
  transactionHash    String?          @map("transaction_hash") @db.VarChar(66)
  transactionId      String?          @unique @map("transaction_id") @db.Uuid
  processingFee      Decimal          @default(0) @map("processing_fee") @db.Decimal(20, 6)
  exchangeRate       Decimal?         @map("exchange_rate") @db.Decimal(10, 6)
  destinationAmount  Decimal?         @map("destination_amount") @db.Decimal(20, 6)
  destinationCurrency String?         @map("destination_currency") @db.VarChar(3)
  adminNotes         String?          @map("admin_notes")
  flaggedReason      String?          @map("flagged_reason")
  riskScore          Int?             @map("risk_score")
  approvedBy         String?          @map("approved_by") @db.Uuid
  rejectedBy         String?          @map("rejected_by") @db.Uuid
  rejectionReason    String?          @map("rejection_reason")
  approvedAt         DateTime?        @map("approved_at")
  rejectedAt         DateTime?        @map("rejected_at")
  completedAt        DateTime?        @map("completed_at")
  failedAt           DateTime?        @map("failed_at")
  failureReason      String?          @map("failure_reason")
  requestedAt        DateTime         @default(now()) @map("requested_at")
  estimatedArrival   DateTime?        @map("estimated_arrival")
  trackingNumber     String?          @map("tracking_number") @db.VarChar(100)
  metadata           Json             @default("{}")

  user               User?            @relation(fields: [userId], references: [id])
  transaction        Transaction?     @relation(fields: [transactionId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedAt(sort: Desc)])
  @@map("withdrawals")
}

// ============================================================================
// DISPUTES
// ============================================================================

model Dispute {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId       String?               @map("transaction_id") @db.Uuid
  escrowId            String?               @map("escrow_id") @db.Uuid
  cardTransactionId   String?               @map("card_transaction_id") @db.Uuid
  filedBy             String?               @map("filed_by") @db.Uuid
  disputeType         DisputeType           @map("dispute_type")
  status              DisputeStatus         @default(open)
  description         String
  amountDisputed      Decimal?              @map("amount_disputed") @db.Decimal(20, 6)
  evidenceUrls        String[]              @map("evidence_urls")
  evidenceDescription String?               @map("evidence_description")
  responseFromParty   String?               @map("response_from_party")
  responseAt          DateTime?             @map("response_at")
  resolution          String?
  resolutionAction    String?               @map("resolution_action") @db.VarChar(50)
  refundAmount        Decimal?              @map("refund_amount") @db.Decimal(20, 6)
  assignedTo          String?               @map("assigned_to") @db.Uuid
  resolvedBy          String?               @map("resolved_by") @db.Uuid
  priority            SupportTicketPriority @default(medium)
  internalNotes       String?               @map("internal_notes")
  metadata            Json                  @default("{}")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  resolvedAt          DateTime?             @map("resolved_at")
  closedAt            DateTime?             @map("closed_at")

  transaction         Transaction?          @relation(fields: [transactionId], references: [id])
  escrow              Escrow?               @relation(fields: [escrowId], references: [id])
  cardTransaction     CardTransaction?      @relation(fields: [cardTransactionId], references: [id])
  filedByUser         User?                 @relation("DisputesFiled", fields: [filedBy], references: [id])

  @@index([transactionId])
  @@index([filedBy])
  @@index([status])
  @@map("disputes")
}

// ============================================================================
// FRAUD ALERTS
// ============================================================================

model FraudAlert {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  transactionId     String?   @map("transaction_id") @db.Uuid
  alertType         String    @map("alert_type") @db.VarChar(50)
  alertCategory     String?   @map("alert_category") @db.VarChar(50)
  riskScore         Int?      @map("risk_score")
  riskLevel         String?   @map("risk_level") @db.VarChar(20)
  details           Json?
  indicators        String[]
  status            String    @default("open") @db.VarChar(20)
  falsePositive     Boolean   @default(false) @map("false_positive")
  investigatedBy    String?   @map("investigated_by") @db.Uuid
  investigationNotes String?  @map("investigation_notes")
  resolution        String?
  actionTaken       String?   @map("action_taken") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at")
  investigatedAt    DateTime? @map("investigated_at")
  resolvedAt        DateTime? @map("resolved_at")

  user              User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@index([riskLevel])
  @@map("fraud_alerts")
}

// ============================================================================
// EMAIL PAYMENTS
// ============================================================================

model EmailPayment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId        String?   @map("sender_id") @db.Uuid
  recipientEmail  String    @map("recipient_email") @db.VarChar(255)
  amountUsdc      Decimal   @map("amount_usdc") @db.Decimal(20, 6)
  message         String?
  claimCode       String    @unique @map("claim_code") @db.VarChar(50)
  claimLink       String?   @unique @map("claim_link") @db.VarChar(255)
  status          String    @default("pending") @db.VarChar(20)
  transactionId   String?   @unique @map("transaction_id") @db.Uuid
  claimedBy       String?   @map("claimed_by") @db.Uuid
  reminderCount   Int       @default(0) @map("reminder_count")
  lastReminderAt  DateTime? @map("last_reminder_at")
  expiresAt       DateTime? @map("expires_at")
  claimedAt       DateTime? @map("claimed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  refundedAt      DateTime? @map("refunded_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  sender          User?     @relation("EmailPaymentsSent", fields: [senderId], references: [id])
  claimer         User?     @relation("EmailPaymentsClaimed", fields: [claimedBy], references: [id])
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  @@index([senderId])
  @@index([recipientEmail])
  @@index([status])
  @@index([claimCode])
  @@map("email_payments")
}

// ============================================================================
// SUPPORT TICKETS
// ============================================================================

model SupportTicket {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber         String               @unique @map("ticket_number") @db.VarChar(20)
  userId               String?              @map("user_id") @db.Uuid
  subject              String               @db.VarChar(500)
  description          String
  category             String?              @db.VarChar(100)
  subcategory          String?              @db.VarChar(100)
  status               SupportTicketStatus  @default(open)
  priority             SupportTicketPriority @default(medium)
  assignedTo           String?              @map("assigned_to") @db.Uuid
  tags                 String[]
  attachments          String[]
  relatedTransactionId String?              @map("related_transaction_id") @db.Uuid
  relatedCardId        String?              @map("related_card_id") @db.Uuid
  satisfactionRating   Int?                 @map("satisfaction_rating")
  satisfactionFeedback String?              @map("satisfaction_feedback")
  firstResponseAt      DateTime?            @map("first_response_at")
  resolvedAt           DateTime?            @map("resolved_at")
  closedAt             DateTime?            @map("closed_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  user                 User?                @relation(fields: [userId], references: [id])
  relatedCard          Card?                @relation(fields: [relatedCardId], references: [id])
  messages             SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String    @map("ticket_id") @db.Uuid
  senderId    String?   @map("sender_id") @db.Uuid
  message     String
  isInternal  Boolean   @default(false) @map("is_internal")
  attachments String[]
  createdAt   DateTime  @default(now()) @map("created_at")

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User?         @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  type              NotificationType
  channel           NotificationChannel @default(in_app)
  title             String             @db.VarChar(255)
  message           String
  actionUrl         String?            @map("action_url")
  actionText        String?            @map("action_text") @db.VarChar(100)
  priority          String             @default("normal") @db.VarChar(20)
  isRead            Boolean            @default(false) @map("is_read")
  readAt            DateTime?          @map("read_at")
  metadata          Json               @default("{}")
  relatedEntityType String?            @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?            @map("related_entity_id") @db.Uuid
  scheduledFor      DateTime?          @map("scheduled_for")
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================================================
// USER PREFERENCES
// ============================================================================

model UserPreference {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String   @unique @map("user_id") @db.Uuid
  emailNotifications      Boolean  @default(true) @map("email_notifications")
  smsNotifications        Boolean  @default(false) @map("sms_notifications")
  pushNotifications       Boolean  @default(true) @map("push_notifications")
  transactionNotifications Boolean @default(true) @map("transaction_notifications")
  marketingEmails         Boolean  @default(false) @map("marketing_emails")
  securityAlerts          Boolean  @default(true) @map("security_alerts")
  kycUpdates              Boolean  @default(true) @map("kyc_updates")
  cardNotifications       Boolean  @default(true) @map("card_notifications")
  escrowNotifications     Boolean  @default(true) @map("escrow_notifications")
  disputeUpdates          Boolean  @default(true) @map("dispute_updates")
  newsletterSubscription  Boolean  @default(false) @map("newsletter_subscription")
  notificationPreferences Json     @default("{}") @map("notification_preferences")
  privacySettings         Json     @default("{}") @map("privacy_settings")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  adminId        String?   @map("admin_id") @db.Uuid
  action         String    @db.VarChar(100)
  actionCategory String?   @map("action_category") @db.VarChar(50)
  resourceType   String?   @map("resource_type") @db.VarChar(50)
  resourceId     String?   @map("resource_id") @db.Uuid
  changes        Json?
  oldValues      Json?     @map("old_values")
  newValues      Json?     @map("new_values")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  location       String?   @db.VarChar(255)
  country        String?   @db.VarChar(2)
  deviceInfo     Json?     @map("device_info")
  success        Boolean   @default(true)
  errorMessage   String?   @map("error_message")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User?     @relation("UserAuditLogs", fields: [userId], references: [id])
  admin          User?     @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================================
// SYSTEM SETTINGS
// ============================================================================

model SystemSetting {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue Json     @map("setting_value")
  settingType  String?  @map("setting_type") @db.VarChar(50)
  description  String?
  isSensitive  Boolean  @default(false) @map("is_sensitive")
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

// ============================================================================
// SCHEDULED REPORTS
// ============================================================================

model ScheduledReport {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  reportName        String    @map("report_name") @db.VarChar(255)
  reportType        String    @map("report_type") @db.VarChar(100)
  scheduleCron      String?   @map("schedule_cron") @db.VarChar(100)
  recipients        String[]
  filters           Json      @default("{}")
  format            String    @default("pdf") @db.VarChar(20)
  isActive          Boolean   @default(true) @map("is_active")
  lastGeneratedAt   DateTime? @map("last_generated_at")
  nextGenerationAt  DateTime? @map("next_generation_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  generatedReports  GeneratedReport[]

  @@map("scheduled_reports")
}

model GeneratedReport {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduledReportId  String?          @map("scheduled_report_id") @db.Uuid
  generatedBy        String?          @map("generated_by") @db.Uuid
  reportType         String           @map("report_type") @db.VarChar(100)
  fileUrl            String?          @map("file_url")
  fileSize           BigInt?          @map("file_size")
  dateRangeStart     DateTime?        @map("date_range_start")
  dateRangeEnd       DateTime?        @map("date_range_end")
  filtersApplied     Json?            @map("filters_applied")
  rowCount           Int?             @map("row_count")
  status             String           @default("completed") @db.VarChar(20)
  expiresAt          DateTime?        @map("expires_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  scheduledReport    ScheduledReport? @relation(fields: [scheduledReportId], references: [id])

  @@map("generated_reports")
}

// ============================================================================
// RATE LIMIT VIOLATIONS
// ============================================================================

model RateLimitViolation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  endpoint       String?  @db.VarChar(255)
  violationCount Int      @default(1) @map("violation_count")
  windowStart    DateTime? @map("window_start")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("rate_limit_violations")
}

// ============================================================================
// REFERRALS
// ============================================================================

model Referral {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId     String?   @map("referrer_id") @db.Uuid
  refereeId      String?   @unique @map("referee_id") @db.Uuid
  referralCode   String?   @map("referral_code") @db.VarChar(20)
  status         String    @default("pending") @db.VarChar(20)
  rewardAmount   Decimal?  @map("reward_amount") @db.Decimal(20, 6)
  rewardPaid     Boolean   @default(false) @map("reward_paid")
  conditionsMet  Boolean   @default(false) @map("conditions_met")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  referrer       User?     @relation("ReferralsGiven", fields: [referrerId], references: [id])
  referee        User?     @relation("ReferralsReceived", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@index([referralCode])
  @@map("referrals")
}
