# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mayaglobalpay
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Web3Auth Configuration
WEB3AUTH_CLIENT_ID=your-web3auth-client-id
WEB3AUTH_CLIENT_SECRET=your-web3auth-client-secret
WEB3AUTH_VERIFIER_NAME=your-verifier-name
WEB3AUTH_NETWORK=testnet
WEB3AUTH_JWKS_URL=https://api-auth.web3auth.io/jwks

# Circle Paymaster (Base Network)
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_API_URL=https://api.circle.com/v1/w3s
CIRCLE_PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
CIRCLE_WEBHOOK_SECRET=your-webhook-secret
CIRCLE_ENTITY_SECRET=your-entity-secret

# Base Network Configuration
BASE_RPC_URL_MAINNET=https://mainnet.base.org
BASE_RPC_URL_TESTNET=https://sepolia.base.org
BASE_CHAIN_ID_MAINNET=8453
BASE_CHAIN_ID_TESTNET=84532
USDC_CONTRACT_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_CONTRACT_TESTNET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DEFAULT_NETWORK=testnet

# Encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_ALGORITHM=aes-256-gcm

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@mayaglobalpay.com
FROM_NAME=Maya Global Pay
SUPPORT_EMAIL=support@mayaglobalpay.com

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Monitoring & Error Tracking
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_TRANSACTIONS=10
RATE_LIMIT_ADMIN=200

# Paystack (Card Provider & Payments)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# Feature Flags
ENABLE_CARDS=true
ENABLE_ESCROW=true
ENABLE_EMAIL_PAYMENTS=true
ENABLE_2FA=true
ENABLE_KYC=true
MAINTENANCE_MODE=false

# Transaction Limits (Default - can be overridden per user)
DEFAULT_DAILY_LIMIT=10000.00
DEFAULT_MONTHLY_LIMIT=50000.00
DEFAULT_TRANSACTION_LIMIT=5000.00
MIN_TRANSACTION_AMOUNT=1.00

# Fee Configuration
TRANSACTION_FEE_PERCENT=0.5
WITHDRAWAL_FEE_PERCENT=1.0
CARD_ISSUANCE_FEE=5.00
CARD_MONTHLY_FEE=2.00

# KYC Settings
KYC_DOCUMENT_MAX_SIZE=10485760
KYC_DOCUMENT_ALLOWED_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Session & Security
SESSION_TIMEOUT=3600000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800000

# Cron Jobs
ENABLE_CRON_JOBS=true
TRANSACTION_MONITOR_INTERVAL=30000
CLEANUP_JOB_SCHEDULE=0 0 * * *
REPORT_GENERATION_SCHEDULE=0 1 * * *

# Application URLs
FRONTEND_URL=http://localhost:3001
FRONTEND_URL_PROD=https://www.mayaglobal.com
BACKEND_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3002
